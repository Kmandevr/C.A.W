---
caw: 1
kind: generator
name: Grit Kick
summary: Four-on-the-floor kick with nonlinear wave-shaping and bit-crushed grit
mode: float
---

param tune = 42 in 30..70 step 1 "Kick bass pitch in Hz"
param decay = 0.32 in 0.08..0.8 step 0.01 "Kick tail length"
param grit = 0.22 in 0..0.6 step 0.01 "Amount of noisy attack"
param drive = 6 in 1..12 step 0.5 "Wave-shaping intensity"
param bits = 8 in 2..16 step 1 "Wave resolution: lower means crunchier"

let hit = step % 4 == 0

let body = drum.kick(hit, tune, decay)
let click = hpf(noise(), 2500, 1.2) * ad(hit, 0.0005, 0.025) * grit

// Nonlinear waveshaping adds harmonics to the original kick instead of layering another oscillator.
let shaped = tanh((body + click) * drive)

// Quantize the shaped waveform for a second, digital crunch stage.
let q = 2 ** (floor(bits) - 1)
floor(shaped * q + 0.5) / q * 0.9
