<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.1 (API 27) and up: the styles of values/, plus drawing under the display cutout. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Phone landscape draws edge to edge, under the camera cutout too; the app keeps controls out of it. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/caw_startup</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
