<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0 (API 26): the launch and normal themes. Both are the startup screen's dark colour in light and dark
     mode, so nothing flashes before Flutter's first frame. values-v27 adds the cutout, values-v31 the splash API. -->
<resources>
    <!-- While the process starts; removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI from then on (seen only for a moment, e.g. while the window resizes). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/caw_startup</item>
    </style>
</resources>
