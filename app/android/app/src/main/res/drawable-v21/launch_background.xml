<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window before Flutter's first frame (Android 8 to 11; Android 12+ also sets the splash API in
     values-v31): the startup screen's background alone, so the first frame, the waveform reveal, follows unbroken. -->
