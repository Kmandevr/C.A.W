# CMake package config for the installed C.A.W. C++ SDK.
@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/CAWSDKTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CAWComponent.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CAWClap.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CAWVst3.cmake")
# Clang's float flags depend on this build's frontend (clang or clang-cl), so they are chosen here,
# not baked into the package: no fused multiply-add contraction, no fast-math (see caw/detmath.hpp).
if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    target_compile_options(CAW::SDK INTERFACE /fp:precise /clang:-ffp-contract=off)
  else()
    target_compile_options(CAW::SDK INTERFACE -ffp-contract=off -fno-fast-math -fno-trapping-math)
  endif()
endif()
