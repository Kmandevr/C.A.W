# Writes a C++ file that holds one binary file's bytes (the recorded instrument parts in engine/assets/): run with
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P EmbedFile.cmake
# The bytes become `extern const unsigned char SYMBOL[]` and `extern const std::size_t SYMBOL_size` in caw::assets. A
# CMake script, not a host tool, so a cross build (Android, clang-cl) needs nothing that runs on the build machine.
if(NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
  message(FATAL_ERROR "EmbedFile.cmake needs INPUT, OUTPUT and SYMBOL")
endif()
file(SIZE "${INPUT}" size)
set(body "")
set(chunk 32768)
set(at 0)
while(at LESS size)
  file(READ "${INPUT}" hex OFFSET ${at} LIMIT ${chunk} HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "${hex}\n")
  math(EXPR at "${at} + ${chunk}")
endwhile()
file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/EmbedFile.cmake from ${INPUT}: do not edit.\n"
  "#include <cstddef>\n"
  "namespace caw::assets {\n"
  "extern const unsigned char ${SYMBOL}[];\n"
  "extern const std::size_t ${SYMBOL}_size;\n"
  "alignas(16) const unsigned char ${SYMBOL}[] = {\n${body}};\n"
  "const std::size_t ${SYMBOL}_size = ${size};\n"
  "}  // namespace caw::assets\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
