# Defines a C.A.W. component target from a project-local JSON manifest.
include_guard(GLOBAL)

function(caw_add_component)
  cmake_parse_arguments(CAW "" "MANIFEST;TARGET" "" ${ARGN})
  if(CAW_UNPARSED_ARGUMENTS OR NOT CAW_MANIFEST)
    message(FATAL_ERROR "caw_add_component requires MANIFEST and accepts optional TARGET")
  endif()

  get_filename_component(_manifest "${CAW_MANIFEST}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "C.A.W. component manifest not found: ${_manifest}")
  endif()
  get_filename_component(_manifest_dir "${_manifest}" DIRECTORY)
  file(REAL_PATH "${_manifest_dir}" _manifest_root)
  file(READ "${_manifest}" _json)

  string(JSON _format ERROR_VARIABLE _json_error GET "${_json}" format)
  if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _format STREQUAL "caw.component")
    message(FATAL_ERROR "Invalid C.A.W. component manifest format in ${_manifest}")
  endif()
  string(JSON _version ERROR_VARIABLE _json_error GET "${_json}" version)
  if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _version EQUAL 1)
    message(FATAL_ERROR "Unsupported C.A.W. component manifest version in ${_manifest}")
  endif()
  string(JSON _id ERROR_VARIABLE _json_error GET "${_json}" component id)
  if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _id MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
    message(FATAL_ERROR "Invalid or missing component.id in ${_manifest}")
  endif()

  string(JSON _source_count ERROR_VARIABLE _json_error LENGTH "${_json}" sources)
  if(NOT _json_error STREQUAL "NOTFOUND" OR _source_count LESS 1)
    message(FATAL_ERROR "A C.A.W. component must list at least one source in ${_manifest}")
  endif()

  set(_sources)
  math(EXPR _last_source "${_source_count} - 1")
  foreach(_index RANGE 0 ${_last_source})
    string(JSON _source ERROR_VARIABLE _json_error GET "${_json}" sources ${_index})
    if(NOT _json_error STREQUAL "NOTFOUND" OR _source STREQUAL "")
      message(FATAL_ERROR "Invalid source entry ${_index} in ${_manifest}")
    endif()
    string(REPLACE "\\" "/" _source_normalized "${_source}")
    if(IS_ABSOLUTE "${_source}" OR _source_normalized MATCHES "^[A-Za-z]:" OR
       _source_normalized MATCHES "(^|/)\.\.(/|$)")
      message(FATAL_ERROR "Component source must stay inside its project: ${_source}")
    endif()
    get_filename_component(_source_path "${_source}" ABSOLUTE BASE_DIR "${_manifest_dir}")
    if(NOT EXISTS "${_source_path}" OR IS_DIRECTORY "${_source_path}")
      message(FATAL_ERROR "Component source not found: ${_source_path}")
    endif()
    file(REAL_PATH "${_source_path}" _source_real)
    string(FIND "${_source_real}" "${_manifest_root}/" _source_prefix)
    if(NOT _source_prefix EQUAL 0)
      message(FATAL_ERROR "Component source resolves outside its project: ${_source}")
    endif()
    list(APPEND _sources "${_source_real}")
  endforeach()

  if(CAW_TARGET)
    set(_target "${CAW_TARGET}")
  else()
    string(MAKE_C_IDENTIFIER "caw_component_${_id}" _target)
  endif()
  if(TARGET ${_target})
    message(FATAL_ERROR "C.A.W. component target already exists: ${_target}")
  endif()

  add_library(${_target} MODULE ${_sources})
  target_link_libraries(${_target} PRIVATE CAW::SDK)
  target_compile_features(${_target} PRIVATE cxx_std_20)
  set_target_properties(${_target} PROPERTIES
    PREFIX ""
    CXX_VISIBILITY_PRESET hidden
    VISIBILITY_INLINES_HIDDEN ON
    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/artifacts"
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/artifacts"
    ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/artifacts"
  )
  set_property(TARGET ${_target} PROPERTY CAW_COMPONENT_ID "${_id}")

  string(JSON _include_count ERROR_VARIABLE _json_error LENGTH "${_json}" includeDirectories)
  if(_json_error STREQUAL "NOTFOUND" AND _include_count GREATER 0)
    math(EXPR _last_include "${_include_count} - 1")
    set(_include_dirs)
    foreach(_index RANGE 0 ${_last_include})
      string(JSON _include ERROR_VARIABLE _json_error GET "${_json}" includeDirectories ${_index})
      string(REPLACE "\\" "/" _include_normalized "${_include}")
      if(NOT _json_error STREQUAL "NOTFOUND" OR _include STREQUAL "" OR
         IS_ABSOLUTE "${_include}" OR _include_normalized MATCHES "^[A-Za-z]:" OR
         _include_normalized MATCHES "(^|/)\.\.(/|$)")
        message(FATAL_ERROR "Invalid component include directory: ${_include}")
      endif()
      get_filename_component(_include_path "${_include}" ABSOLUTE BASE_DIR "${_manifest_dir}")
      if(NOT IS_DIRECTORY "${_include_path}")
        message(FATAL_ERROR "Component include directory not found: ${_include_path}")
      endif()
      file(REAL_PATH "${_include_path}" _include_real)
      string(FIND "${_include_real}" "${_manifest_root}/" _include_prefix)
      if(NOT _include_prefix EQUAL 0)
        message(FATAL_ERROR "Component include directory resolves outside its project: ${_include}")
      endif()
      list(APPEND _include_dirs "${_include_real}")
    endforeach()
    target_include_directories(${_target} PRIVATE ${_include_dirs})
  endif()

  string(JSON _definition_count ERROR_VARIABLE _json_error LENGTH "${_json}" compileDefinitions)
  if(_json_error STREQUAL "NOTFOUND" AND _definition_count GREATER 0)
    math(EXPR _last_definition "${_definition_count} - 1")
    set(_definitions)
    foreach(_index RANGE 0 ${_last_definition})
      string(JSON _definition ERROR_VARIABLE _json_error GET "${_json}" compileDefinitions ${_index})
      if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _definition MATCHES "^[A-Za-z_][A-Za-z0-9_]*(=.*)?$")
        message(FATAL_ERROR "Invalid component compile definition: ${_definition}")
      endif()
      list(APPEND _definitions "${_definition}")
    endforeach()
    target_compile_definitions(${_target} PRIVATE ${_definitions})
  endif()

  set(CAW_COMPONENT_TARGET "${_target}" PARENT_SCOPE)
endfunction()
