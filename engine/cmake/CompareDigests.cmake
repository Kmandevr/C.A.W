# Speed phase 5c: every reference render's raw-bit digest from the one-thread shards against the mix-pool shards.
if(NOT DIGEST_DIR)
  message(FATAL_ERROR "DIGEST_DIR is not set")
endif()
foreach(kind serial parallel)
  set(${kind}_lines "")
  foreach(shard RANGE 0 3)
    set(f "${DIGEST_DIR}/${kind}_${shard}.txt")
    if(NOT EXISTS "${f}")
      message(FATAL_ERROR "${f} is missing: its shard wrote no digests (did it run?)")
    endif()
    file(STRINGS "${f}" lines)
    list(APPEND ${kind}_lines ${lines})
  endforeach()
  list(SORT ${kind}_lines)
endforeach()
list(LENGTH serial_lines n)
list(LENGTH parallel_lines np)
if(n EQUAL 0)
  message(FATAL_ERROR "no render digests")
endif()
if(NOT n EQUAL np)
  message(FATAL_ERROR "${n} renders on one thread, ${np} with the mix pool")
endif()
set(bad 0)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  list(GET serial_lines ${i} a)
  list(GET parallel_lines ${i} b)
  if(NOT a STREQUAL b)
    message(SEND_ERROR "one thread: ${a}\n  mix pool: ${b}")
    math(EXPR bad "${bad} + 1")
  endif()
endforeach()
if(bad GREATER 0)
  message(FATAL_ERROR "${bad} of ${n} reference renders differ between one thread and the mix pool")
endif()
message(STATUS "${n} reference renders: the same bits on one thread and with the mix pool")
