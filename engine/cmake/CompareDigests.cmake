# Speed phase 5c: every reference render's raw-bit digest from the one-thread shards against the mix-pool shards
# (OTHER=parallel, the default), or against the play-ahead shards (OTHER=ahead: caw_tests --play-ahead 0).
# SHARD_COUNT: the shards CTest registered (CAW_TEST_SHARDS); SHARDS: the ones to compare (all by default; a CI job
# that ran one shard compares that one, and every render belongs to exactly one shard, so a check per shard is as
# strict as one over all of them).
if(NOT DIGEST_DIR)
  message(FATAL_ERROR "DIGEST_DIR is not set")
endif()
if(NOT SHARD_COUNT)
  set(SHARD_COUNT 4)
endif()
if(NOT DEFINED SHARDS)
  math(EXPR last_shard "${SHARD_COUNT} - 1")
  set(SHARDS "")
  foreach(shard RANGE 0 ${last_shard})
    list(APPEND SHARDS ${shard})
  endforeach()
endif()
if(NOT OTHER)
  set(OTHER parallel)
endif()
if(OTHER STREQUAL "ahead")
  set(other_name "play-ahead")
else()
  set(other_name "the mix pool")
endif()
foreach(kind serial ${OTHER})
  set(${kind}_lines "")
  foreach(shard IN LISTS SHARDS)
    set(f "${DIGEST_DIR}/${kind}_${shard}.txt")
    if(NOT EXISTS "${f}")
      message(FATAL_ERROR "${f} is missing: its shard wrote no digests (did it run?)")
    endif()
    file(STRINGS "${f}" lines)
    list(APPEND ${kind}_lines ${lines})
  endforeach()
  list(SORT ${kind}_lines)
endforeach()
list(LENGTH serial_lines n)
list(LENGTH ${OTHER}_lines np)
if(n EQUAL 0)
  message(FATAL_ERROR "no render digests")
endif()
if(NOT n EQUAL np)
  message(FATAL_ERROR "${n} renders on one thread, ${np} with ${other_name}")
endif()
set(bad 0)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  list(GET serial_lines ${i} a)
  list(GET ${OTHER}_lines ${i} b)
  if(NOT a STREQUAL b)
    message(SEND_ERROR "one thread: ${a}\n  ${other_name}: ${b}")
    math(EXPR bad "${bad} + 1")
  endif()
endforeach()
if(bad GREATER 0)
  message(FATAL_ERROR "${bad} of ${n} reference renders differ between one thread and ${other_name}")
endif()
message(STATUS "${n} reference renders: the same bits on one thread and with ${other_name}")
